# ==========================================
# HISAB - STAGING ENVIRONMENT
# ==========================================

NODE_ENV=production
TZ=Asia/Dhaka

# ==========================================
# PUBLIC APPLICATION URL
# ==========================================

APP_URL=https://hisab.apptriangle.com
NUXT_PUBLIC_SITE_URL=https://hisab.apptriangle.com

# ==========================================
# APPLICATION PORT
# ==========================================

APP_HOST_PORT=7011
APP_INTERNAL_PORT=3000

HOST=0.0.0.0
PORT=3000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# ==========================================
# POSTGRESQL
# Host port 3318 maps to container port 5432
# ==========================================

POSTGRES_USER=hisab
POSTGRES_PASSWORD=change-me-hisab-db
POSTGRES_DB=hisab
POSTGRES_HOST_PORT=3318

DATABASE_URL=postgresql://hisab:change-me-hisab-db@postgres:5432/hisab

PGHOST=postgres
PGPORT=5432
PGUSER=hisab
PGPASSWORD=change-me-hisab-db
PGDATABASE=hisab

# ==========================================
# APPLICATION SECURITY
# ==========================================

JWT_SECRET=replace-with-generated-random-secret

# Create database schema on first startup
INIT_DB=true

# First owner. Used only while the database has no admin.
# After the owner changes this phone or PIN inside the app, these values no longer log in,
# and a restart does not put them back.
OPENING_PHONE=01936469616
OPENING_PIN=1234
OPENING_NAME= Liton

OPENING_SHOP_NAME=আমার দোকান
